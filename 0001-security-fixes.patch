diff --git a/supabase/rls_policies.sql b/supabase/rls_policies.sql
new file mode 100644
index 0000000..aa84533
--- /dev/null
+++ b/supabase/rls_policies.sql
@@ -0,0 +1,29 @@
+-- Включаем Row Level Security на обеих таблицах
+alter table public.notes enable row level security;
+alter table public.tasks enable row level security;
+
+-- NOTES: пользователь видит и меняет только свои записи
+create policy "notes_select_own" on public.notes
+  for select using (auth.uid() = user_id);
+
+create policy "notes_insert_own" on public.notes
+  for insert with check (auth.uid() = user_id);
+
+create policy "notes_update_own" on public.notes
+  for update using (auth.uid() = user_id);
+
+create policy "notes_delete_own" on public.notes
+  for delete using (auth.uid() = user_id);
+
+-- TASKS: то же самое
+create policy "tasks_select_own" on public.tasks
+  for select using (auth.uid() = user_id);
+
+create policy "tasks_insert_own" on public.tasks
+  for insert with check (auth.uid() = user_id);
+
+create policy "tasks_update_own" on public.tasks
+  for update using (auth.uid() = user_id);
+
+create policy "tasks_delete_own" on public.tasks
+  for delete using (auth.uid() = user_id);
diff --git a/supabase/storage_policies.sql b/supabase/storage_policies.sql
new file mode 100644
index 0000000..044f6a3
--- /dev/null
+++ b/supabase/storage_policies.sql
@@ -0,0 +1,18 @@
+-- Storage: bucket "images"
+-- Заливать файлы можно только в свою папку {user_id}/...
+create policy "images_insert_own_folder" on storage.objects
+  for insert with check (
+    bucket_id = 'images'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  );
+
+-- Публичное чтение (нужно, т.к. в коде используется getPublicUrl)
+create policy "images_public_select" on storage.objects
+  for select using (bucket_id = 'images');
+
+-- Удалять/менять — только свои файлы
+create policy "images_delete_own_folder" on storage.objects
+  for delete using (
+    bucket_id = 'images'
+    and (storage.foldername(name))[1] = auth.uid()::text
+  );
